{
  "__inputs": [
    {
      "name": "DS_PROM",
      "label": "Prometheus / VictoriaMetrics datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "dashboard": {
    "editable": true,
    "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 0,
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "pointSize": 0
            },
            "unit": "watt"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "band laag"
              },
              "properties": [
                {
                  "id": "custom.lineWidth",
                  "value": 1
                },
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "dash": [
                      4,
                      4
                    ],
                    "fill": "dash"
                  }
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#ffa94d",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "band hoog"
              },
              "properties": [
                {
                  "id": "custom.lineWidth",
                  "value": 1
                },
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "dash": [
                      4,
                      4
                    ],
                    "fill": "dash"
                  }
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#ffa94d",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "prognose 24u"
              },
              "properties": [
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "dash": [
                      8,
                      4
                    ],
                    "fill": "dash"
                  }
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#ffa94d",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "werkelijk"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#e8eaf2",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "gridPos": {
          "h": 9,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull"
            ],
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "targets": [
          {
            "expr": "home_power_watts{entity=\"sensor.electriciteitskast_power\",kind=\"actual\"}",
            "legendFormat": "werkelijk",
            "range": true,
            "refId": "A"
          },
          {
            "expr": "home_power_watts{entity=\"sensor.electriciteitskast_power\",kind=\"forecast\"}",
            "legendFormat": "prognose 24u",
            "range": true,
            "refId": "B"
          },
          {
            "expr": "home_power_watts{entity=\"sensor.electriciteitskast_power\",kind=\"band_low\"}",
            "legendFormat": "band laag",
            "range": true,
            "refId": "C"
          },
          {
            "expr": "home_power_watts{entity=\"sensor.electriciteitskast_power\",kind=\"band_high\"}",
            "legendFormat": "band hoog",
            "range": true,
            "refId": "D"
          }
        ],
        "title": "Huishoudvermogen \u2014 werkelijk vs prognose (next 24u)",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 0,
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "pointSize": 0
            },
            "unit": "watt"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "werkelijk"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#e8eaf2",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "prognose (24u eerder gemaakt)"
              },
              "properties": [
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "dash": [
                      8,
                      4
                    ],
                    "fill": "dash"
                  }
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#4dd599",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "gridPos": {
          "h": 9,
          "w": 16,
          "x": 0,
          "y": 9
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "targets": [
          {
            "expr": "home_power_watts{entity=\"sensor.electriciteitskast_power\",kind=\"actual\"}",
            "legendFormat": "werkelijk",
            "range": true,
            "refId": "A"
          },
          {
            "expr": "home_power_watts{entity=\"sensor.electriciteitskast_power\",kind=\"forecast_24h_ago\"}",
            "legendFormat": "prognose (24u eerder gemaakt)",
            "range": true,
            "refId": "B"
          }
        ],
        "timeFrom": "now-24h",
        "timeShift": null,
        "title": "Prognose-nauwkeurigheid \u2014 voorspeld gisteren vs werkelijk (24u terugblik)",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 100
                },
                {
                  "color": "red",
                  "value": 250
                }
              ]
            },
            "unit": "watt"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 9,
          "w": 8,
          "x": 16,
          "y": 9
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "home_power_watts_mae24{entity=\"sensor.electriciteitskast_power\"}",
            "range": false,
            "refId": "A"
          }
        ],
        "title": "Prognosefout (MAE, 24u vooruit)",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 0,
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "pointSize": 0
            },
            "unit": "kwatth"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "prognose 24u"
              },
              "properties": [
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "dash": [
                      8,
                      4
                    ],
                    "fill": "dash"
                  }
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#ffa94d",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "werkelijk"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#e8eaf2",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "gridPos": {
          "h": 9,
          "w": 24,
          "x": 0,
          "y": 18
        },
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull"
            ],
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "targets": [
          {
            "expr": "home_energy_kwh{entity=\"sensor.electriciteitskast_energy\",kind=\"actual\"}",
            "legendFormat": "werkelijk",
            "range": true,
            "refId": "A"
          },
          {
            "expr": "home_energy_kwh{entity=\"sensor.electriciteitskast_energy\",kind=\"forecast\"}",
            "legendFormat": "prognose 24u",
            "range": true,
            "refId": "B"
          }
        ],
        "title": "Verbruik \u2014 werkelijk vs prognose (kWh per 15 min)",
        "type": "timeseries"
      }
    ],
    "refresh": "10m",
    "tags": [
      "timesfm",
      "energy"
    ],
    "time": {
      "from": "now-3d",
      "to": "now+1d"
    },
    "timezone": "browser",
    "title": "Energie prognose (TimesFM)",
    "uid": "adf2fd"
  }
}