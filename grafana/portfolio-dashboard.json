{
  "__inputs": [
    {
      "name": "DS_PROM",
      "label": "Prometheus / VictoriaMetrics datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "dashboard": {
    "editable": true,
    "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 0,
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "pointSize": 0
            },
            "unit": "currencyEUR"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "prognose 30d (uitgelijnd: eindigt vandaag)"
              },
              "properties": [
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "dash": [
                      8,
                      4
                    ],
                    "fill": "dash"
                  }
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#ffa94d",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "band laag"
              },
              "properties": [
                {
                  "id": "custom.lineWidth",
                  "value": 1
                },
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "dash": [
                      4,
                      4
                    ],
                    "fill": "dash"
                  }
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#ffa94d",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "band hoog"
              },
              "properties": [
                {
                  "id": "custom.lineWidth",
                  "value": 1
                },
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "dash": [
                      4,
                      4
                    ],
                    "fill": "dash"
                  }
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#ffa94d",
                    "mode": "fixed"
                  }
                },
                {
                  "id": "custom.fillOpacity",
                  "value": 8
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "werkelijk"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#e8eaf2",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "gridPos": {
          "h": 14,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull"
            ],
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "targets": [
          {
            "expr": "portfolio_value_eur{kind=\"actual\"}",
            "legendFormat": "werkelijk",
            "range": true,
            "refId": "A"
          },
          {
            "expr": "portfolio_value_eur{kind=\"forecast\"}",
            "legendFormat": "prognose 30d (uitgelijnd: eindigt vandaag)",
            "range": true,
            "refId": "B"
          },
          {
            "expr": "portfolio_value_eur{kind=\"band_low\"}",
            "legendFormat": "band laag",
            "range": true,
            "refId": "C"
          },
          {
            "expr": "portfolio_value_eur{kind=\"band_high\"}",
            "legendFormat": "band hoog",
            "range": true,
            "refId": "D"
          }
        ],
        "title": "Portefeuillewaarde \u2014 werkelijk vs prognose",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "orange",
                  "value": null
                }
              ]
            },
            "unit": "currencyEUR"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 0,
          "y": 14
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "portfolio_value_eur_forecast_last",
            "range": false,
            "refId": "A"
          }
        ],
        "title": "Prognose over 30 dagen",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 200
                },
                {
                  "color": "red",
                  "value": 1000
                }
              ]
            },
            "unit": "currencyEUR"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 6,
          "y": 14
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "noValue": "begint over ~7 dagen",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "portfolio_value_eur_mae7",
            "range": false,
            "refId": "A"
          }
        ],
        "title": "Prognosefout (MAE, 7d vooruit)",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 0,
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "pointSize": 0
            },
            "unit": "currencyEUR"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "werkelijk"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#e8eaf2",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "prognose (7d eerder gemaakt)"
              },
              "properties": [
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "dash": [
                      8,
                      4
                    ],
                    "fill": "dash"
                  }
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#4dd599",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 14
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "targets": [
          {
            "expr": "portfolio_value_eur{kind=\"actual\"}",
            "legendFormat": "werkelijk",
            "range": true,
            "refId": "A"
          },
          {
            "expr": "portfolio_value_eur{kind=\"forecast_7d_ago\"}",
            "legendFormat": "prognose (7d eerder gemaakt)",
            "range": true,
            "refId": "B"
          }
        ],
        "timeFrom": "now-30d",
        "title": "Prognose-nauwkeurigheid \u2014 voorspeld 7d eerder vs werkelijk",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "description": "Groen = bullish (>+3%), rood = bearish (<-3%), oranje = neutraal. TimesFM-prijsprognose per positie, dagelijks berekend.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": -3
                },
                {
                  "color": "green",
                  "value": 3
                }
              ]
            },
            "unit": "percent"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 10,
          "w": 24,
          "x": 0,
          "y": 22
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "value_and_name",
          "wideLayout": true
        },
        "targets": [
          {
            "expr": "stock_forecast_return_pct",
            "format": "time_series",
            "intervalMs": 300000,
            "legendFormat": "{{symbol}}",
            "maxDataPoints": 30,
            "queryType": "range",
            "range": true,
            "refId": "A"
          }
        ],
        "title": "Bullish / bearish \u2014 verwacht 30d rendement per positie (drempel \u00b13%)",
        "type": "stat"
      }
    ],
    "refresh": "1h",
    "tags": [
      "timesfm",
      "portfolio"
    ],
    "time": {
      "from": "now-6M",
      "to": "now"
    },
    "timezone": "browser",
    "title": "Portfolio prognose (TimesFM)",
    "uid": "axdnvl"
  }
}